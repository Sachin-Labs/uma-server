# Server
PORT=5000
NODE_ENV=development

# MongoDB (REQUIRED — server will not boot without this)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname

# JWT (REQUIRED — never hardcode; use `openssl rand -hex 32`)
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email Provider
# Options: 'console' (log to terminal), 'ethereal' (fake SMTP + preview URL), 'smtp' (real delivery)
EMAIL_PROVIDER=console

# SMTP Config (REQUIRED only when EMAIL_PROVIDER=smtp)
# For Brevo: host=smtp-relay.brevo.com, port=587
# For Gmail: host=smtp.gmail.com, port=587
# For AWS SES: host=email-smtp.us-east-1.amazonaws.com, port=587
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login-email
SMTP_PASS=your-brevo-smtp-key

# Sender address (REQUIRED when using a real email provider)
EMAIL_FROM=noreply@sina-people.com
EMAIL_SENDER_NAME=SINA People

# HTTP API providers (REQUIRED only when EMAIL_PROVIDER=brevo / sendgrid)
BREVO_API_KEY=
SENDGRID_API_KEY=

# Client
CLIENT_URL=http://localhost:5173

# Office Config
OFFICE_START_TIME=09:00
